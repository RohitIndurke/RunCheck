{
  "name": "runcheck",
  "version": "0.1.1",
  "description": "CLI doctor for Node.js projects — spot root-cause blockers before you hit them",
  "bin": {
    "runcheck": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": ["cli", "node", "doctor", "devtools", "dx"],
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "pnpm": ">=8"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "execa": "^9.3.0",
    "picocolors": "^1.1.0",
    "semver": "^7.6.3"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/semver": "^7.5.8",
    "tsup": "^8.2.4",
    "tsx": "^4.16.0",
    "typescript": "^5.5.3",
    "vitest": "^2.0.5"
  }
}
